{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "noEmit": false,
    "outDir": "dist-electron",
    "rootDir": "src",
    "sourceMap": true,
    "isolatedModules": false
  },
  "include": [
    "src/electron-main.ts",
    "src/electron-capture.ts",
    "src/preload.cts",
    "src/electron-test-entry.ts",
    "src/electron-live-telemetry-check.ts",
    "src/mavlink.ts",
    "src/parity.ts",
    "src/replay.ts",
    "src/state.ts"
  ]
}
