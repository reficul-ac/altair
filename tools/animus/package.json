{
  "name": "altair-animus",
  "productName": "Altair Animus",
  "description": "Desktop MAVLink 3D viewer for Altair SITL.",
  "author": "Altair",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/reficul-ac/altair.git",
    "directory": "tools/animus"
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron-main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "app": "npm run build && electron .",
    "capture": "electron dist-electron/electron-capture.js --",
    "test:electron-live": "node dist-electron/electron-live-telemetry-check.js",
    "dist:appimage": "npm run build && electron-builder --linux AppImage --publish never",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run src"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "three": "^0.184.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.184.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "ac.reficul.altair.animus",
    "productName": "Altair Animus",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science"
    }
  }
}
