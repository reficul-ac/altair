if(NOT DEFINED CSV_FILE)
  message(FATAL_ERROR "CSV_FILE is required")
endif()

file(STRINGS "${CSV_FILE}" CSV_ROWS)
list(LENGTH CSV_ROWS CSV_ROW_COUNT)
if(CSV_ROW_COUNT LESS 3)
  message(FATAL_ERROR "CSV file has too few data rows: ${CSV_FILE}")
endif()

list(GET CSV_ROWS 1 FIRST_ROW)
math(EXPR LAST_INDEX "${CSV_ROW_COUNT} - 1")
list(GET CSV_ROWS ${LAST_INDEX} LAST_ROW)

string(REPLACE "," ";" FIRST_FIELDS "${FIRST_ROW}")
string(REPLACE "," ";" LAST_FIELDS "${LAST_ROW}")

list(GET FIRST_FIELDS 13 FIRST_N)
list(GET FIRST_FIELDS 14 FIRST_E)
list(GET FIRST_FIELDS 11 FIRST_LAT)
list(GET FIRST_FIELDS 30 FIRST_ALT)
list(GET LAST_FIELDS 13 LAST_N)
list(GET LAST_FIELDS 14 LAST_E)
list(GET LAST_FIELDS 11 LAST_LAT)
list(GET LAST_FIELDS 30 LAST_ALT)
if(FIRST_N STREQUAL LAST_N AND FIRST_E STREQUAL LAST_E)
  message(FATAL_ERROR "SITL trajectory did not move horizontally in ${CSV_FILE}")
endif()
if(FIRST_LAT STREQUAL LAST_LAT)
  message(FATAL_ERROR "SITL latitude did not change in ${CSV_FILE}")
endif()
if(FIRST_ALT STREQUAL LAST_ALT)
  message(FATAL_ERROR "SITL altitude did not change in ${CSV_FILE}")
endif()
